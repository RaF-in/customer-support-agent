# Required — get one at https://platform.openai.com/api-keys
# (embeddings + chat model; per-provider chat keys are mapped in
# src/app/infrastructure/llm/factory.py)
OPENAI_API_KEY=sk-replace-me

# Optional overrides (defaults shown)
QDRANT_URL=http://localhost:6333
EMBEDDING_PROVIDER=openai

# Port conflict on 6333? Change the host port HERE (docker-compose.yml reads
# this value) and point QDRANT_URL above at the new port. Do not edit the
# compose file directly.
# QDRANT_PORT=6333

# Tunable pipeline limits (defaults shown) — see src/app/infrastructure/settings.py
# MAX_FILE_SIZE_MB=200
# MAX_PAGES=1000
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# EMBEDDING_BATCH_SIZE=100

# Concurrency caps for remote I/O (async data layer): max parallel Qdrant
# requests per gathered operation, and max concurrent OpenAI embedding
# requests per embed call
# QDRANT_MAX_CONCURRENCY=8
# EMBEDDING_MAX_CONCURRENCY=4

# --- Graphs / workflows subsystem (LangGraph) ------------------------------
# Chat models (purpose-keyed temperatures are fixed in the factory, not here)
# LLM_PROVIDER=openai
# CHAT_MODEL=gpt-4o-mini

# Loop bounds (defaults shown) — every graph loop is settings-driven, never
# hardcoded; defaults reproduce the ARCH latency budget (≤ ~25 LLM calls)
# SELF_RAG_MAX_REWRITES=2
# SELF_RAG_MAX_REVISIONS=2
# SELF_RAG_TOP_K=4
# LIVE_DATA_MAX_STEPS=8

# Conversational orchestrator bounds (defaults shown) — transcript size,
# routing, and the planner/executor cycles are all settings-driven.
# CONVERSATION_HISTORY_MAX_MESSAGES=0 reads as unlimited (full transcript).
# POSTGRES_POOL_MAX_SIZE is the concurrent-turns lever: each active turn
# holds one pool connection for its advisory lock.
# CONVERSATION_MAX_MESSAGE_CHARS=8000
# CONVERSATION_HISTORY_MAX_MESSAGES=0
# CLARIFY_MAX_CONSECUTIVE=2
# PLANNER_MAX_ATTEMPTS=3
# EXECUTOR_MAX_REINVOCATIONS=3
# PLAN_MAX_STEPS=8
# POSTGRES_POOL_MAX_SIZE=10

# MCP tool servers (JSON, langchain-mcp-adapters client format), e.g.
# MCP_SERVERS={"orders":{"command":"python","args":["-m","orders_server"]}}
# MCP_SERVERS={}
# Per-tenant tool allowlist (JSON: tenant -> [tool names]). Deny-by-default:
# a tenant absent from this map gets NO tools.
# MCP_TENANT_ALLOWLIST={}

# Postgres — the row-state substrate: conversation transcripts, plan
# records, approval requests, and action-result audit. A default compose
# service: it starts with plain `docker compose up -d`, and the credentials
# in docker-compose.yml must match this DSN; change both together.
# POSTGRES_DSN=postgresql://app:app@localhost:5432/app
