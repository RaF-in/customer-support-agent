# Required — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-me

# Optional overrides (defaults shown)
QDRANT_URL=http://localhost:6333
EMBEDDING_PROVIDER=openai

# Port conflict on 6333? Change the host port HERE (docker-compose.yml reads
# this value) and point QDRANT_URL above at the new port. Do not edit the
# compose file directly.
# QDRANT_PORT=6333

# Tunable pipeline limits (defaults shown) — see src/app/infrastructure/settings.py
# MAX_FILE_SIZE_MB=200
# MAX_PAGES=1000
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# EMBEDDING_BATCH_SIZE=100
